FROM node:22.12.0-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY app ./app
COPY providers ./providers
COPY utils ./utils
COPY public ./public
COPY *.mjs jsconfig.json ./
ENV NEXT_PUBLIC_REACT_APP_API_URL=/api/
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build
EXPOSE 3000
CMD ["npm", "run", "start"]
