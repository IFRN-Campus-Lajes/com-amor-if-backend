+ await waitFor(() => expect(postPrivateData).toHaveBeenCalledWith("admin/regras-automaticas/reprocessar", { bimestre: 2 }, "token"));
+ await screen.findByRole("status"); expect(fetchPrivateData).toHaveBeenCalledTimes(2);
