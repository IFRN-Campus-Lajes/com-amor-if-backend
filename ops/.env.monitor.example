# Copie este arquivo para /deploy/.env.monitor na VM e preencha os valores.
DEPLOY_DIR=/deploy
BACKEND_DIR=/deploy/backend
FRONTEND_DIR=/deploy/frontend
COMPOSE_FILE=/deploy/docker-compose.yml
LOG_FILE=/deploy/logs/deploy-monitor.log

# Exemplo para Gmail com senha de aplicativo.
SMTP_URL=smtps://smtp.gmail.com:465
SMTP_USERNAME=seu-email@gmail.com
SMTP_PASSWORD=senha-de-aplicativo
SMTP_FROM=seu-email@gmail.com
EMAIL_TO=destinatario@exemplo.com
